CREATE TABLE Клиенты (
    код_клиента SERIAL PRIMARY KEY,
    фамилия VARCHAR(50) NOT NULL,
    имя VARCHAR(50) NOT NULL,
    отчество VARCHAR(50),
    дата_рождения DATE NOT NULL,
    представитель_фирмы VARCHAR(100),
    адрес VARCHAR(255) NOT NULL,
    контактный_телефон VARCHAR(20) NOT NULL
);

CREATE TABLE Заказы (
    номер_заказа SERIAL PRIMARY KEY,
    код_клиента INT NOT NULL,
    дата_заказа DATE NOT NULL,
    срок_сборки DATE NOT NULL,
    доп_информация TEXT,
    адрес_доставки VARCHAR(255) NOT NULL,

    CONSTRAINT fk_заказы_клиенты FOREIGN KEY (код_клиента) 
        REFERENCES Клиенты (код_клиента)
        ON DELETE CASCADE
);
